# Public URL of this app (used to build OAuth callback URLs).
EMBER_URL=http://localhost:4100

# Database. Leave empty locally (uses data/ember.db). Required on Vercel/serverless:
# turso.tech > your database > Connect. The schema is created automatically on first request.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# GitHub OAuth app (free): github.com/settings/developers > New OAuth App
#   Homepage: http://localhost:4100   Callback: http://localhost:4100/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# X (Twitter) OAuth 2.0 app. Optional: X's API is pay-per-use since Feb 2026,
# so each X sign-in costs a small fee. Leave empty to hide the X button.: developer.x.com > your app > User authentication settings
#   Type: Web App (confidential client). Callback: http://localhost:4100/api/auth/callback/x
X_CLIENT_ID=
X_CLIENT_SECRET=

# Google OAuth client: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web)
#   Authorized redirect URI: http://localhost:4100/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development only: show a "sign in as an existing user" shortcut on /login.
# Ignored in production builds.
EMBER_DEV_LOGIN=1

# Google Search Console: choose "URL prefix", then the "HTML tag" method, and
# paste only the content="..." value here. Then redeploy and click Verify.
GOOGLE_SITE_VERIFICATION=
