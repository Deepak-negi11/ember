{
  "name": "embertime",
  "version": "0.1.5",
  "description": "Connect VS Code, Cursor, Windsurf, Claude Code and Codex to Ember in one command. Tracks coding time, never code or prompts.",
  "type": "module",
  "bin": {
    "embertime": "cli.mjs"
  },
  "files": [
    "cli.mjs",
    "editors.mjs",
    "postinstall.mjs",
    "ember-hook.mjs",
    "install.mjs",
    "hooks",
    ".claude-plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "time-tracking",
    "wakatime",
    "claude-code",
    "codex",
    "cursor",
    "vscode",
    "heatmap"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "postinstall": "node postinstall.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deepak-negi11/ember.git",
    "directory": "collectors/agent-hook"
  },
  "homepage": "https://ember-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/Deepak-negi11/ember/issues"
  }
}
